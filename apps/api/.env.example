# Where eSewa/Khalti return the payer (funtush-frontend). ESEWA_MERCHANT_CODE + KHALTI_SECRET_KEY enable checkout;
# USD_NPR_RATE=140  (plan prices are USD; gateways charge NPR = ceil(price x rate))
# ESEWA_BASE_URL / KHALTI_BASE_URL default to the sandboxes outside production.
BILLING_RETURN_URL=http://localhost:3001/dashboard/billing/return
