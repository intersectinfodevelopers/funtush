{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ESNext",
    "types": ["node", "react"],
    "baseUrl": ".",
    "paths": {
      "@funtush/auth": [
        "../../packages/auth/src/index.ts"
      ],
      "@funtush/database": [
        "../../packages/database/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "../../packages/auth/src/utils/lockout.ts",
    "../../packages/auth/src/utils/redis.ts",
    "../../packages/auth/src/utils/otpRateLimit.ts",
    "src/test"
  ],
  // Quarantined fraud-detection / fingerprint pipeline (see the "deferred
  // features" backlog): none of these files is imported by app.ts or anything
  // else that runs, and they reference Prisma models that don't exist yet
  // (ipRegistration, fingerprint, trialUsage, ...). Excluded so typecheck
  // reflects code that actually ships; remove an entry when its feature is
  // built for real.
  "exclude": [
    "node_modules",
    "src/routes/FraudDetectionRoutes.ts",
    "src/routes/fingerprintRoutes.ts",
    "src/services/FraudDetectionDatabaseService.ts",
    "src/services/fingerprintDatabaseService.ts",
    "src/services/fingerprintService.ts"
  ]
}