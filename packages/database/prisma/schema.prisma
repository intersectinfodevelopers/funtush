// Payroll (Day 3): what an agency owes a guide or staff member for a period of
// work, or for one specific trek. A payroll row starts as DRAFT — a plan, no
// accounting impact — and only hits the ledger when it is marked PAID, which
// generates the journal entry (Debit Payroll Expense, Credit Cash).
enum PayrollStatus {
  DRAFT
  PAID
}

model Payroll {
  id       String @id @default(uuid())
  agencyId String @map("agency_id")

  // Exactly one of these is set (enforced by a CHECK constraint in the
  // migration). There is no Guide table yet — guides arrive with the mobile
  // app in Phase 3 — so `guideId` mirrors Booking.assignedGuideId as a plain
  // id string. `staffId` is a real foreign key to agency_staff.
  guideId String? @map("guide_id")
  staffId String? @map("staff_id")

  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date

  amount       Decimal @db.Decimal(12, 2)
  currencyCode String  @default("NPR") @map("currency_code")

  status PayrollStatus @default(DRAFT)

  // Set when compensation is "per trek" rather than "per period".
  bookingId String? @map("booking_id")
  notes     String?

  // The journal entry generated by mark-paid. Null while DRAFT. Unique, so a
  // payroll row can never be posted to the ledger twice.
  journalEntryId String?   @unique @map("journal_entry_id")
  paidAt         DateTime? @map("paid_at")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agency       Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  staff        AgencyStaff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)
  booking      Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  creator      AgencyUser?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([agencyId, status])
  @@index([agencyId, periodStart])
  @@index([guideId])
  @@index([staffId])
  @@map("payrolls")
}

