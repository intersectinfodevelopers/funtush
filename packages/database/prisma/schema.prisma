generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgencyStatus {
  TRIAL
  ACTIVE
  LOCKED
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  AGENCY_ADMIN
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
  TENANT_ADMIN
  STAFF
}

enum RoleType {
  PLATFORM
  TENANT
  TREKKER
}

enum BookingStatus {
  INQUIRY
  CONFIRMED
  PAYMENT_PENDING
  REJECTED
  ALTERNATIVE_PROPOSED
  PAID
  ACTIVE
  COMPLETED
  CANCELLED
}

enum KycStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum KycDocumentType {
  BUSINESS_REGISTRATION
  PAN_CERTIFICATE
  TOURISM_LICENSE
  BANK_DETAILS
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PackageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DepartureStatus {
  AVAILABLE
  FULL
  GUARANTEED
}

enum TrekDifficulty {
  EASY
  MODERATE
  CHALLENGING
  DIFFICULT
}

enum CommunicationType {
  EMAIL
  WHATSAPP
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

enum ReviewFlagStatus {
  PENDING
  DISMISSED
  REMOVED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CouponStatus {
  ACTIVE
  PAUSED
  EXPIRED
}

/// What kind of number an `AgencyEmergencyContact` row holds.
///
/// The *national* emergency numbers (police / ambulance) are bundled in the app
/// binary and looked up offline by country code — Backend Guide §10, SOS layer 1
/// — so they are deliberately NOT stored here. These rows are the trek-specific
/// numbers the app cannot know in advance.
enum EmergencyContactType {
  /// The agency's own 24/7 operations desk.
  AGENCY_DESK
  /// Helicopter / ground rescue operator contracted for this trek.
  RESCUE
  /// Nearest hospital or clinic on the route.
  MEDICAL
  /// Local liaison, lodge owner, or area coordinator.
  LOCAL_CONTACT
  /// Insurance assistance hotline.
  INSURANCE
}

/// Which app store / runtime a registered device token came from.
///
/// Firebase Cloud Messaging needs this because the *same* logical notification
/// is delivered differently per platform: Android reads the `android.priority`
/// block, iOS reads the `apns.payload.aps` block, and web push reads neither.
/// Storing the platform next to the token is what lets the sender build the
/// right message shape without a second lookup — Backend Guide §13.
enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

model SubscriptionTier {
  id           String  @id @default(uuid())
  name         String  @unique
  maxStaff     Int     @map("max_staff")
  maxGuides    Int     @map("max_guides")
  monthlyPrice Decimal @map("monthly_price") @db.Decimal(10, 2)
  features     Json

  agencies      Agency[]
  subscriptions Subscription[]

  @@map("subscription_tiers")
}

model Agency {
  adCampaigns       AdCampaign[]
  id                String                 @id @default(uuid())
  name              String
  email             String                 @unique
  slug              String                 @unique
  status            AgencyStatus           @default(TRIAL)
  tierId            String                 @map("tier_id")
  customDomain      String?                @map("custom_domain")
  mapsUrl           String?                @map("maps_url")
  priorityOverride  Int                    @default(0) @map("priority_override")
  trialExpiresAt    DateTime?              @map("trial_expires_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  tier              SubscriptionTier       @relation(fields: [tierId], references: [id])
  users             AgencyUser[]
  agencyStaffs      AgencyStaff[]
  profile           AgencyProfile?
  branding          AgencyBranding?
  siteConfig        AgencySiteConfig?
  kyc               KycSubmission?
  subscriptions     Subscription[]
  packages          TrekPackage[]
  destinations      TrekDestination[]
  bookings          Booking[]
  customerNotes     CustomerNote[]
  communicationLogs CommunicationLog[]
  reviews           Review[]
  visibilityScore   AgencyVisibilityScore?

  marketplaceImpressions MarketplaceImpression[]
  marketplaceClicks      MarketplaceClick[]
  coupons                Coupon[]
  branches               Branch[]

  emergencyContacts AgencyEmergencyContact[]
  guideProfiles     GuideProfile[]

  paymentMethods AgencyPaymentMethod[]
  accounts       Account[]
  journalEntries JournalEntry[]
  payrolls       Payroll[]

  bugReports BugReport[]
  apiKeys    ApiKey[]
  navigation AgencyNavigation?

  stripeSubscription StripeSubscription?

  khaltiTransactions         KhaltiTransaction[]
  esewaTransactions          EsewaTransaction[]
  connectIPSTransactions     ConnectIPSTransaction[]
  nepaliPaymentVerifications NepaliPaymentVerification[]

  fonepayQRCode       FonepayQRCode?
  fonepayTransactions FonepayTransaction[]
  categories          Category[]
  blogs               Blog[]

  @@map("agencies")
}

model AgencyPaymentMethod {
  id       String @id @default(cuid())
  agencyId String @map("agency_id")
  provider String // STRIPE | KHALTI | ESEWA | CONNECTIPS | FONEPAY

  credentialsEncrypted String @map("credentials_encrypted") // AES-256-GCM encrypted JSON

  isActive  Boolean   @default(true) @map("is_active")
  rotatedAt DateTime? @map("rotated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, provider])
  @@index([agencyId])
  @@index([provider])
  @@map("agency_payment_methods")
}

model AgencyVisibilityScore {
  id       String @id @default(uuid())
  agencyId String @unique @map("agency_id")
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  baseScore    Int @default(0) @map("base_score") // from tier.name: FREE=0, SMALL=25, MEDIUM=50, LARGE=100
  qualityBonus Int @default(0) @map("quality_bonus") // rating(+20) + recentBooking(+5) + profileComplete(+10)
  finalScore   Int @default(0) @map("final_score") // baseScore + qualityBonus + agency.priorityOverride

  calculatedAt DateTime @default(now()) @map("calculated_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([finalScore])
  @@map("agency_visibility_scores")
}

model AgencyUser {
  id           String        @id @default(uuid())
  agencyId     String        @map("agency_id")
  userId       String        @map("user_id")
  role         UserRole      @default(STAFF)
  joinedAt     DateTime      @default(now()) @map("joined_at")
  agency       Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyStaffs AgencyStaff[]

  customerNotes     CustomerNote[]
  communicationLogs CommunicationLog[]
  reviewResponses   ReviewResponse[]
  journalEntries    JournalEntry[]
  payrolls          Payroll[]

  @@unique([agencyId, userId])
  @@map("agency_users")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  roleType     RoleType @map("role_type")

  trekker Trekker?

  refreshTokens RefreshToken[]

  /// LEGACY — the original single-token field (one phone per account).
  ///
  /// Superseded by the `deviceTokens` relation below (Mobile week · Day 3), which
  /// supports the real case of a trekker with a phone *and* a tablet. Kept only
  /// because `notification.service.ts` still reads it; new code must not write it.
  fcmToken String? @map("fcm_token")

  /// Every device this user has registered for push. See `DeviceToken`.
  deviceTokens DeviceToken[]

  agencyUsers AgencyUser[]

  assignedBugs BugReport[] @relation("BugAssignee")
  bugHints     BugHint[]

  failedAttempts Int @default(0)

  isLocked  Boolean   @default(false)
  lockUntil DateTime?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

/// ── Push token registry (Mobile week · Day 3) ────────────────────────────────
///
/// One row per *device*, not per user. A trekker who owns a phone and a tablet
/// has two rows; both must ring when an SOS fires, so push delivery reads the
/// whole set for a user rather than a single column.
///
/// Nothing here is agency data, so there is no `tenant_id`: a device belongs to a
/// platform-level `User`, exactly like the `Trekker` identity in Backend Guide §7.
/// Isolation is enforced by the fact that every query is keyed on `user_id`.
model DeviceToken {
  id String @id @default(uuid())

  /// The account currently signed in on this device.
  userId String @map("user_id")

  /// The FCM registration token — the address Firebase delivers to.
  ///
  /// **Unique**, and that uniqueness is the whole design. Firebase issues one
  /// token per app installation, so the token *is* the device's identity. If
  /// Asha logs out of the office iPad and Bina logs in, Firebase hands the app
  /// the same token; the unique constraint forces that row to be reassigned to
  /// Bina instead of creating a duplicate that would push Asha's private trek
  /// details to a phone she no longer holds.
  fcmToken String @unique @map("fcm_token")

  /// Android / iOS / Web — decides the message shape the sender builds.
  platform DevicePlatform

  /// Last time the app proved this token is still live, by re-registering it.
  ///
  /// FCM silently stops delivering to tokens untouched for ~270 days, so this is
  /// what lets a cleanup job drop dead rows instead of pushing into the void.
  lastActiveAt DateTime @default(now()) @map("last_active_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// `Cascade`: deleting the account deletes its devices. A push token that
  /// outlived its owner is a notification sent to a stranger's phone.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "Every token for this user" is the read path of every push send.
  @@index([userId])
  /// Supports the stale-token cleanup job's `lastActiveAt < cutoff` scan.
  @@index([lastActiveAt])
  @@map("device_tokens")
}

model Trekker {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  fullName              String?
  phone                 String?
  country               String?
  nationality           String?
  emergencyContactName  String?
  emergencyContactPhone String?

  isEmailVerified Boolean   @default(false)
  emailVerifiedAt DateTime?

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  preference        TrekkerPreference?
  customerNotes     CustomerNote[]
  communicationLogs CommunicationLog[]
  reviews           Review[]

  marketplaceClicks MarketplaceClick[]

  @@map("trekker")
}

model TrekkerPreference {
  id String @id @default(uuid())

  trekkerId String @unique @map("trekker_id")

  preferredDestinations Json? @map("preferred_destinations")
  budgetRange           Json? @map("budget_range")
  groupSizePreference   Int?  @map("group_size_preference")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trekker Trekker @relation(fields: [trekkerId], references: [id], onDelete: Cascade)

  @@map("trekker_preferences")
}

model CustomerNote {
  id String @id @default(uuid())

  agencyId  String @map("agency_id")
  trekkerId String @map("trekker_id")
  staffId   String @map("staff_id")

  noteText String @map("note_text")

  createdAt DateTime @default(now()) @map("created_at")

  agency  Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  trekker Trekker    @relation(fields: [trekkerId], references: [id], onDelete: Cascade)
  staff   AgencyUser @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([agencyId, trekkerId])
  @@map("customer_notes")
}

model CommunicationLog {
  id String @id @default(uuid())

  agencyId  String  @map("agency_id")
  trekkerId String  @map("trekker_id")
  staffId   String? @map("staff_id")

  type      CommunicationType
  direction CommunicationDirection

  subject String?
  message String

  sentAt DateTime @default(now()) @map("sent_at")

  agency  Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  trekker Trekker     @relation(fields: [trekkerId], references: [id], onDelete: Cascade)
  staff   AgencyUser? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([agencyId, trekkerId])
  @@map("communication_logs")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Role {
  id           String           @id @default(uuid())
  agencyId     String           @map("agency_id")
  name         String
  description  String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  permissions  RolePermission[]
  agencyStaffs AgencyStaff[]

  @@unique([agencyId, name])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String     @map("role_id")
  permissionKey String     @map("permission_key")
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model AgencyStaff {
  id              String     @id @default(uuid())
  agencyId        String     @map("agency_id")
  userId          String     @map("user_id")
  roleId          String?    @map("role_id")
  isActive        Boolean    @default(true) @map("is_active")
  invitedAt       DateTime   @default(now()) @map("invited_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  user            AgencyUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            Role?      @relation(fields: [roleId], references: [id])
  agency          Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  managedBranches Branch[]   @relation("BranchManager")
  payrolls        Payroll[]

  @@unique([agencyId, userId])
  @@index([agencyId])
  @@index([roleId])
  @@map("agency_staff")
}

model TrekPackage {
  id             String         @id @default(uuid())
  agencyId       String         @map("agency_id")
  title          String
  slug           String         @unique
  description    String?
  durationDays   Int            @map("duration_days")
  pricePerPerson Decimal        @map("price_per_person") @db.Decimal(10, 2)
  difficulty     TrekDifficulty
  maxGroupSize   Int            @map("max_group_size")
  status         PackageStatus  @default(DRAFT)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  availableToAllBranches Boolean @default(true)

  /// ISO 3166-1 alpha-2 country the trek physically takes place in ("NP", "IN").
  /// The mobile app uses this to pick the right set of national emergency
  /// numbers out of the offline database bundled in its binary (Backend Guide
  /// §10, SOS layer 1), so it must travel inside the offline package.
  countryCode String? @map("country_code")

  agency          Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  itineraries     TrekItinerary[]
  departureDates  TrekDepartureDate[]
  addOns          TrekAddOn[]
  destinations    TrekDestination[]
  bookings        Booking[]
  packageBranches PackageBranch[]
  packingItems    TrekPackingItem[]

  @@index([agencyId])
  @@map("trek_packages")
}

model TrekDestination {
  id         String        @id @default(uuid())
  agencyId   String        @map("agency_id")
  name       String
  region     String?
  altitudeM  Int?          @map("altitude_m")
  bestSeason String?       @map("best_season")
  createdAt  DateTime      @default(now()) @map("created_at")
  agency     Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  packages   TrekPackage[]

  @@index([agencyId])
  @@map("trek_destinations")
}

model TrekItinerary {
  id          String      @id @default(uuid())
  packageId   String      @map("package_id")
  dayNumber   Int         @map("day_number")
  location    String?
  description String?
  altitudeM   Int?        @map("altitude_m")
  photos      String[]    @default([])
  package     TrekPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@map("trek_itineraries")
}

/// One line on a trek's packing list.
///
/// Modelled as rows rather than a `Json` blob on `TrekPackage` because the
/// agency dashboard needs to edit, reorder and reuse individual items, and
/// Backend Guide §3 puts relational, editable data in Postgres. It is also what
/// lets the offline package hash notice that a single item changed.
model TrekPackingItem {
  id        String @id @default(uuid())
  packageId String @map("package_id")

  /// Grouping header the app renders, e.g. "Clothing", "Gear", "Documents".
  category    String
  /// The thing to bring, e.g. "Down jacket (-20°C rated)".
  item        String
  /// Free text rather than a number: real lists say "2 pairs", "1–2 L".
  quantity    String?
  /// Essential items are rendered first and flagged — missing one can end a trek.
  isEssential Boolean @default(false) @map("is_essential")
  /// Manual ordering inside a category; ties fall back to `item` alphabetically.
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  package TrekPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@map("trek_packing_items")
}

/// A phone number the trekker may need in the field, owned by one agency.
///
/// Tenant-scoped (Backend Guide §4): these are the agency's own desk, rescue and
/// medical contacts, never another agency's.
model AgencyEmergencyContact {
  id       String @id @default(uuid())
  agencyId String @map("agency_id")

  /// Human label shown next to the call button, e.g. "Ops desk (24/7)".
  label String
  /// Stored in full international form (+977…) so the phone can dial it offline
  /// without knowing which country it is currently in.
  phone String
  type  EmergencyContactType

  /// Optional second line, and an optional note ("ask for the duty manager").
  altPhone String? @map("alt_phone")
  notes    String?

  /// Ordering in the app's emergency screen — lowest first.
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@map("agency_emergency_contacts")
}

/// Contact details for a guide, so the offline package can carry them.
///
/// There is still no first-class `Guide` model, and `Booking.assignedGuideId` is
/// a bare string with no foreign key that different code paths fill with a
/// `User.id`, an `AgencyUser.id` or an `AgencyStaff.id` (see
/// `resolveGuideIdentity` in `mobile.service.ts`). `guideRef` therefore mirrors
/// that column as a plain string and is resolved in the service layer. When a
/// real `Guide` model lands this becomes a normal relation.
model GuideProfile {
  id       String @id @default(uuid())
  agencyId String @map("agency_id")
  /// Matches whatever `Booking.assignedGuideId` holds for this guide.
  guideRef String @map("guide_ref")

  fullName       String   @map("full_name")
  phone          String
  altPhone       String?  @map("alt_phone")
  /// Satellite phone — often the only number that works above the treeline.
  satellitePhone String?  @map("satellite_phone")
  /// Languages the guide speaks, e.g. ["en", "ne", "de"].
  languages      String[] @default([])
  isActive       Boolean  @default(true) @map("is_active")

  branchId String? @map("branch_id")
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  /// One profile per guide per agency — the pair the service looks up by.
  @@unique([agencyId, guideRef])
  @@index([agencyId])
  @@index([branchId])
  @@map("guide_profiles")
}

model TrekDepartureDate {
  id          String          @id @default(uuid())
  packageId   String          @map("package_id")
  startDate   DateTime        @map("start_date")
  maxSlots    Int             @map("max_slots")
  bookedSlots Int             @default(0) @map("booked_slots")
  status      DepartureStatus @default(AVAILABLE)
  package     TrekPackage     @relation(fields: [packageId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  @@index([packageId])
  @@map("trek_departure_dates")
}

model TrekAddOn {
  id            String         @id @default(uuid())
  packageId     String         @map("package_id")
  name          String
  price         Decimal        @db.Decimal(10, 2)
  perPerson     Boolean        @default(false) @map("per_person")
  createdAt     DateTime       @default(now()) @map("created_at")
  package       TrekPackage    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  bookingAddOns BookingAddOn[]

  @@index([packageId])
  @@map("trek_add_ons")
}

model Booking {
  id              String        @id @default(uuid())
  agencyId        String        @map("agency_id")
  trekkerId       String?       @map("trekker_id")
  packageId       String        @map("package_id")
  branchId        String?       @map("branch_id")
  departureDateId String        @map("departure_date_id")
  groupSize       Int           @map("group_size")
  totalPrice      Decimal       @map("total_price") @db.Decimal(10, 2)
  status          BookingStatus @default(INQUIRY)
  trekkerName     String        @map("trekker_name")
  trekkerEmail    String        @map("trekker_email")
  trekkerPhone    String        @map("trekker_phone")
  trekkerCountry  String?       @map("trekker_country")
  specialRequests String?       @map("special_requests")
  rejectionReason String?       @map("rejection_reason")
  proposedDate    DateTime?     @map("proposed_date") @db.Date
  assignedGuideId String?       @map("assigned_guide_id")

  /// ── Offline package versioning (Mobile week · Day 2) ──────────────────────
  /// Monotonic counter the app compares against its cached copy. It starts at 1
  /// and only ever moves up, so "my cached version < server version" is always a
  /// safe test for "I must refetch".
  offlinePackageVersion Int @default(1) @map("offline_package_version")

  /// SHA-256 of the bundle's content. This is what makes the counter above
  /// *correct*: the bundle is assembled from six different tables, so instead of
  /// asking every writer to remember to bump a counter, we fingerprint the
  /// content we just built and bump only when the fingerprint changed.
  offlinePackageHash String? @map("offline_package_hash")

  /// When the version last changed — surfaced to the app for display/debugging.
  offlinePackageUpdatedAt DateTime? @map("offline_package_updated_at")

  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  agency           Agency            @relation(fields: [agencyId], references: [id])
  trekker          Trekker?          @relation(fields: [trekkerId], references: [id])
  package          TrekPackage       @relation(fields: [packageId], references: [id])
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  departureDate    TrekDepartureDate @relation(fields: [departureDateId], references: [id])
  addOns           BookingAddOn[]
  paymentLink      PaymentLink?
  review           Review?
  reviewInvitation ReviewInvitation?
  journalEntries   JournalEntry[]
  payrolls         Payroll[]

  @@index([agencyId, status])
  @@index([trekkerId])
  @@map("bookings")
}

model BookingAddOn {
  id             String  @id @default(uuid())
  bookingId      String  @map("booking_id")
  addOnId        String  @map("addon_id")
  quantity       Int     @default(1)
  priceAtBooking Decimal @map("price_at_booking") @db.Decimal(10, 2)

  booking Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOn   TrekAddOn @relation(fields: [addOnId], references: [id])

  @@unique([bookingId, addOnId])
