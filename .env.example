# ── PostgreSQL (Prisma) ──────────────────────────────
DATABASE_URL="postgresql://funtush:funtush@localhost:5432/funtush?schema=public"

# ── Redis (sessions, cache, rate limiting) ───────────
REDIS_URL="redis://localhost:6379"

# ── MongoDB (audit logs, analytics, email queue) ─────
MONGO_URL="mongodb://localhost:27017/funtush"

# ── Auth ─────────────────────────────────────────────
JWT_SECRET="replace-with-a-long-random-string"
# Required when NODE_ENV=production (staging included): the API refuses to boot
# if these are short, placeholder-looking, or identical to each other.
# Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── API ──────────────────────────────────────────────
PORT=4000
# Extra hostnames served as the main platform (not an agency tenant). Needed on
# staging, where the host isn't funtush.com — otherwise every request 404s in
# production. Comma-separated, e.g. develop.shirijanga.com
PLATFORM_HOSTS=
# Expose Swagger UI at /docs and the spec at /docs.json (non-production default).
ENABLE_DOCS=

# ── Meilisearch (marketplace search) ─────────────────
# Local dev can run without a master key; production MUST set one.
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY=""

# ── Static site regeneration (white-label ISR hook) ──
# All four are OPTIONAL. With none of them set, a branding/config/navigation
# save still succeeds and records a receipt saying "skipped" — the API needs no
# CDN to run locally.
#
# Where the public white-label sites live: <slug>.funtush.io
SITE_BASE_DOMAIN="funtush.io"
# Where this API is reachable — the origin whose JSON the renderer reads, and
# therefore the origin whose cached JSON has to be purged first.
API_PUBLIC_URL="https://api.funtush.com"
# The renderer that builds the static sites. Its POST /api/revalidate is what
# rebuilds pages on demand.
SITE_RENDERER_URL=
# Shared secret for the HMAC signature on that webhook. Rebuilding a page is
# expensive, so the endpoint must not be triggerable by strangers.
SITE_REVALIDATE_SECRET=
SITE_REVALIDATE_TIMEOUT_MS=10000

# ── CDN cache purge ──────────────────────────────────
# e.g. https://api.cloudflare.com/client/v4/zones/<zone-id>/purge_cache
CDN_PURGE_URL=
CDN_PURGE_TOKEN=
CDN_PURGE_TIMEOUT_MS=5000

# -- Cloudflare R2 Storage -----------------------------
STORAGE_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=funtush
CDN_BASE_URL=

# Payment Method Encryption — 64 hex chars, required in production.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Khalti
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=

# eSewa
ESEWA_MERCHANT_CODE=
ESEWA_MERCHANT_SECRET=

# ConnectIPS
CONNECTIPS_CLIENT_ID=
CONNECTIPS_CLIENT_SECRET=

# Fonepay
FONEPAY_MERCHANT_CODE=
FONEPAY_API_KEY=

# Meta Ads
META_ACCESS_TOKEN=          
META_AD_ACCOUNT_ID=         
META_API_VERSION=v21.0       
# Prometheus scrape token. When set, GET /metrics requires "Authorization: Bearer <token>".
# When unset, /metrics is open in development and returns 404 in production (fail closed).
METRICS_TOKEN=

# Number of trusted reverse-proxy hops in front of the API (nginx = 1). Client IP for rate limiting,
# the admin whitelist and audit logs is taken from X-Forwarded-For only across this many hops.
# Use 0 if the API is exposed directly.
TRUSTED_PROXY_HOPS=1

# ── Scale / stability knobs ──────────────────────────────────────────────────
# Recommended DATABASE_URL options for production:
#   ?schema=public&connection_limit=20&pool_timeout=10&options=-c%20statement_timeout%3D20000
#   connection_limit  = pool size PER API PROCESS (total = this x processes; keep under Postgres max_connections,
#                       or put PgBouncer in front). statement_timeout stops one runaway query from pinning a connection.
# Max concurrent in-flight requests per process before the API answers 503 + Retry-After (load shedding).
MAX_INFLIGHT_REQUESTS=400
# A handler running longer than this gets a 503 instead of hanging the client.
REQUEST_HANDLER_TIMEOUT_MS=30000
# Days to keep request access logs in Mongo (TTL index).
REQUEST_LOG_RETENTION_DAYS=30

# Worker processes for `pnpm start` (src/cluster.ts). Default = one per CPU core.
# Total Postgres connections = connection_limit (in DATABASE_URL) x WEB_CONCURRENCY.
# Send SIGUSR2 to the primary for a zero-downtime rolling restart.
WEB_CONCURRENCY=
